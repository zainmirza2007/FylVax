PORT=3000
SITE_URL=https://example.com
SITE_NAME=Fylvex
CONTACT_EMAIL=fylvax@gmail.com

MAX_UPLOAD_MB=200
FILE_RETENTION_MINUTES=60
MAX_CONCURRENT_JOBS=4
RATE_LIMIT_MAX=20
# You may set the real publisher ID during AdSense site verification.
# This adds the non-ad-serving google-adsense-account verification meta tag and ads.txt entry.
ADSENSE_PUBLISHER_ID=
# Ad rendering remains OFF until the site is approved and consent setup is complete.
ADSENSE_ENABLED=false
ADSENSE_SLOT_CONTENT=
# Set true only after a Google-certified CMP has been configured for EEA/UK/Switzerland.
CMP_READY=false
# Optional: require ClamAV in production. If true and clamscan is unavailable, uploads fail closed.
REQUIRE_MALWARE_SCAN=false

# Malware scanning is OFF by default so a fresh container without signatures cannot reject every upload.
ENABLE_MALWARE_SCAN=false
